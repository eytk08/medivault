# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=medivault
# Set to true if your hosted database requires TLS
DB_SSL=false

# Required in production. Use a long random string, for example: openssl rand -hex 32
SESSION_SECRET=change_this_to_a_long_random_string
# Cookies are marked secure (HTTPS only) in production. Set false only for a plain http demo.
# COOKIE_SECURE=true

# Failed login or signup attempts allowed per visitor every 15 minutes
AUTH_RATE_LIMIT=10

# Set to false to create the tables without the fake sample patients
# SEED_DEMO=true

# Set to production when hosting behind HTTPS
# NODE_ENV=production
