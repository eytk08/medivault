{
  "name": "medivault",
  "version": "1.0.0",
  "description": "MEDIVAULT: a medical history web app built with Bootstrap 5, Express and MySQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:prod": "npm run db:ensure && node server.js",
    "dev": "node --watch server.js",
    "db:init": "node scripts/init-db.js",
    "db:seed": "node scripts/init-db.js --seed",
    "db:ensure": "node scripts/init-db.js --seed --if-empty",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "mysql2": "^3.24.5"
  },
  "author": "Phoebe Kate",
  "keywords": [
    "medical-history",
    "bootstrap",
    "express",
    "mysql",
    "sessions"
  ]
}
