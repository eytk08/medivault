{
  "name": "medivault",
  "version": "2.0.0",
  "description": "MediVault: a personal medical history app built with React, Express and MySQL",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:server:dev\" \"npm:client:dev\"",
    "server:dev": "node --watch server.js",
    "client:dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server.js",
    "start:prod": "npm run db:ensure && node server.js",
    "db:init": "node scripts/init-db.js",
    "db:seed": "node scripts/init-db.js --seed",
    "db:ensure": "node scripts/init-db.js --seed --if-empty",
    "test": "node --test test/api.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-tabs": "^1.1.13",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.24.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.7",
    "zod": "^3.25.76",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^6.4.1"
  },
  "author": "Phoebe Kate",
  "keywords": [
    "medical-history",
    "react",
    "express",
    "mysql",
    "sessions"
  ]
}
